# Copy this file to .env and fill in your real values.
# (requires `python-decouple` or `django-environ` wiring if you want
# settings.py to auto-load it — or just `export` these before runserver.)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# --- Official Mail ID / SMTP (server mail from hosting) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@yourdomain.com
EMAIL_HOST_PASSWORD=your-mailbox-password
ENQUIRY_RECEIVER_EMAIL=info@yourdomain.com

# --- Business details shown sitewide ---
GYM_NAME=Iron Revolution
GYM_TAGLINE=Build Your Body and Fitness with Professional Touch
GYM_PHONE=+91 00000 00000
GYM_WHATSAPP_NUMBER=910000000000
GYM_EMAIL=info@yourdomain.com
GYM_ADDRESS=Your Gym Address, City, State, PIN
GYM_HOURS=Mon to Sat: 6:00 AM - 10:00 PM

SOCIAL_FACEBOOK=https://facebook.com/yourgym
SOCIAL_INSTAGRAM=https://instagram.com/yourgym
SOCIAL_YOUTUBE=https://youtube.com/yourgym
SOCIAL_TWITTER=https://twitter.com/yourgym

# Google Maps > Share > Embed a map > copy the src="..." URL here
GOOGLE_MAP_EMBED_URL=https://www.google.com/maps?q=Your+Gym+Location&output=embed

SITE_DOMAIN=https://yourdomain.com
